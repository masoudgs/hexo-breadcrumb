{
  "name": "hexo-breadcrumb",
  "type": "commonjs",
  "version": "1.2.4",
  "description": "Generate breadcrumb for Hexo",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "global.d.ts"
  ],
  "scripts": {
    "build": "rm -rf dist && nr ts:build && npm run bundle",
    "bundle": "node esbuild.config.mjs",
    "ts:check": "tsc -p tsconfig.json --noEmit",
    "ts:build": "tsc -p tsconfig.json",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier '**/*.{js,ts,md,yml,json}' --check",
    "format:fix": "prettier '**/*.{js,ts,md,yml,json}' --write",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "version": "npm run lint:check && npm run test:run && npm run build && git add .",
    "prepare": "husky || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msudgh/hexo-breadcrumb.git"
  },
  "keywords": [
    "breadcrumb",
    "hexojs",
    "hexo",
    "seo"
  ],
  "author": "Masoud Ghorbani <masoudghorbani@pm.me>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/msudgh/hexo-breadcrumb/issues"
  },
  "homepage": "https://github.com/msudgh/hexo-breadcrumb",
  "engines": {
    "node": ">=7.5.0"
  },
  "dependencies": {
    "zod": "4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "9.31.0",
    "@types/hexo": "3.8.12",
    "@typescript-eslint/eslint-plugin": "8.36.0",
    "@typescript-eslint/parser": "8.36.0",
    "@vitest/coverage-v8": "3.2.4",
    "@vitest/ui": "3.2.4",
    "esbuild": "0.25.6",
    "eslint": "9.31.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.1",
    "globals": "^16.3.0",
    "husky": "9.1.7",
    "lint-staged": "16.1.2",
    "prettier": "3.6.2",
    "tap-junit": "5.0.4",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.ts": [
      "pnpm run lint:check"
    ],
    "*.{js,ts,md,yml,json}": [
      "npm run format:check"
    ]
  }
}
